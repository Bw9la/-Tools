  <title> Module - G ExpressLine Transit Network</title>
  <style>
    /* ==========================================================================
       CSS STYLING & 3D VIEWPORT CONTEXT
       ========================================================================== */

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #050505;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
      font-family: 'Courier New', Courier, monospace;
    }

    .scene {
      width: 500px;
      height: 500px;
      perspective: 1200px;
      position: relative;
      cursor: grab;
    }

    .scene:active {
      cursor: grabbing;
    }

    .sphere {
      width: 100%;
      height: 100%;
      position: relative;
      transform-style: preserve-3d;
      will-change: transform;
    }

    .node {
      position: absolute;
      top: 50%;
      left: 50%;
      width: auto;
      height: auto;
      padding: 6px 10px;
      margin: -10px 0 0 -10px;
      font-family: 'Courier New', Courier, monospace;
      font-size: 11px;
      font-weight: bold;
      color: rgba(255, 255, 255, 0.9);
      text-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
      background-color: rgba(10, 10, 10, 0.7);
      border: 1px solid rgba(0, 255, 204, 0.3);
      border-radius: 4px;
      white-space: nowrap;
      transform-style: preserve-3d;
      backface-visibility: visible;
      user-select: none;
      display: flex;
      justify-content: center;
      align-items: center;
      transition: all 0.3s ease;
      cursor: pointer;
    }

    .node:hover {
      color: #00ffcc;
      text-shadow: 0 0 12px #00ffcc;
      border-color: rgba(0, 255, 204, 0.8);
      background-color: rgba(10, 10, 10, 0.95);
      box-shadow: 0 0 20px rgba(0, 255, 204, 0.4);
      transform: scale(1.2) !important;
    }

    .station-label {
      display: block;
      font-size: 10px;
      opacity: 0.8;
    }

    .station-number {
      display: block;
      font-size: 9px;
      color: rgba(0, 255, 204, 0.7);
      margin-top: 2px;
      font-weight: normal;
    }

    .info-panel {
      position: fixed;
      bottom: 20px;
      left: 20px;
      background-color: rgba(5, 5, 5, 0.95);
      border: 2px solid rgba(0, 255, 204, 0.5);
      border-radius: 8px;
      padding: 15px;
      max-width: 300px;
      color: rgba(255, 255, 255, 0.9);
      font-size: 12px;
      display: none;
      box-shadow: 0 0 30px rgba(0, 255, 204, 0.2);
      z-index: 1000;
    }

    .info-panel.active {
      display: block;
      animation: slideIn 0.3s ease;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .info-panel h3 {
      color: #00ffcc;
      margin-bottom: 8px;
      font-size: 14px;
    }

    .info-panel p {
      margin: 4px 0;
      opacity: 0.8;
    }

    .instructions {
      position: fixed;
      top: 20px;
      right: 20px;
      background-color: rgba(5, 5, 5, 0.9);
      border: 1px solid rgba(0, 255, 204, 0.3);
      border-radius: 6px;
      padding: 12px;
      max-width: 250px;
      color: rgba(255, 255, 255, 0.7);
      font-size: 11px;
      line-height: 1.6;
    }

    .branch-list {
      position: fixed;
      left: 20px;
      top: 20px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      max-height: 70vh;
      overflow-y: auto;
      padding: 10px;
      background-color: rgba(5, 5, 5, 0.72);
      border: 1px solid rgba(0, 255, 204, 0.25);
      border-radius: 8px;
      font-size: 11px;
    }

    .branch {
      color: rgba(255, 255, 255, 0.8);
      text-decoration: none;
      padding: 4px 8px;
      border-left: 2px solid rgba(0, 255, 204, 0.4);
      transition: all 0.2s ease;
    }

    .branch:hover {
      color: #00ffcc;
      border-left-color: #00ffcc;
    }
  </style>
</head>
<body>

  <div class="scene">
    <div class="sphere" id="sphere"></div>
  </div>

  <div class="branch-list" aria-label="G line branch list">
    <a class="branch branch1" data-value="G Line Express">G Line Express</a>
    <a class="branch branch2" data-value="Court Sq">Court Sq</a>
    <a class="branch branch3" data-value="Greenpoint Ave">Greenpoint Ave</a>
    <a class="branch branch4" data-value="Metropolitan Ave">Metropolitan Ave</a>
    <a class="branch branch5" data-value="Flushing Ave">Flushing Ave</a>
    <a class="branch branch6" data-value="Bedford-Nostrand">Bedford-Nostrand</a>
    <a class="branch branch7" data-value="Clinton-Washington">Clinton-Washington</a>
    <a class="branch branch8" data-value="Hoyt-Schermerhorn">Hoyt-Schermerhorn</a>
    <a class="branch branch9" data-value="Carroll St">Carroll St</a>
    <a class="branch branch10" data-value="Prospect Park">Prospect Park</a>
    <a class="branch branch11" data-value="Long Island City">Long Island City</a>
    <a class="branch branch12" data-value="Astoria Blvd">Astoria Blvd</a>
    <a class="branch branch13" data-value="Ditmars Blvd">Ditmars Blvd</a>
    <a class="branch branch14" data-value="Jackson Ave">Jackson Ave</a>
    <a class="branch branch15" data-value="Vernon Blvd">Vernon Blvd</a>
    <a class="branch branch16" data-value="Queensboro Plaza">Queensboro Plaza</a>
    <a class="branch branch17" data-value="21st St">21st St</a>
    <a class="branch branch18" data-value="Hunters Point Ave">Hunters Point Ave</a>
    <a class="branch branch19" data-value="Jay St">Jay St</a>
    <a class="branch branch20" data-value="High St">High St</a>
    <a class="branch branch21" data-value="Nostrand Ave">Nostrand Ave</a>
    <a class="branch branch22" data-value="Marcy Ave">Marcy Ave</a>
    <a class="branch branch23" data-value="Broadway">Broadway</a>
  </div>

  <div class="info-panel" id="infoPanel">
    <h3 id="stationName"></h3>
    <p><strong>Station ID:</strong> <span id="stationId"></span></p>
    <p><strong>Position:</strong> <span id="stationPos"></span></p>
  </div>

  <div class="instructions">
    <p>🖱️ <strong>Interact:</strong> Move cursor to rotate</p>
    <p>🔗 <strong>Click:</strong> Select station</p>
    <p>⏱️ <strong>Auto:</strong> Idle rotation</p>
  </div>

  <script>
    const stationData = [
      { id: 1, name: "G Line Express", branch: "branch1" },
      { id: 2, name: "Court Sq", branch: "branch2" },
      { id: 3, name: "Greenpoint Ave", branch: "branch3" },
      { id: 4, name: "Metropolitan Ave", branch: "branch4" },
      { id: 5, name: "Flushing Ave", branch: "branch5" },
      { id: 6, name: "Bedford-Nostrand", branch: "branch6" },
      { id: 7, name: "Clinton-Washington", branch: "branch7" },
      { id: 8, name: "Hoyt-Schermerhorn", branch: "branch8" },
      { id: 9, name: "Carroll St", branch: "branch9" },
      { id: 10, name: "Prospect Park", branch: "branch10" },
      { id: 11, name: "Long Island City", branch: "branch11" },
      { id: 12, name: "Astoria Blvd", branch: "branch12" },
      { id: 13, name: "Ditmars Blvd", branch: "branch13" },
      { id: 14, name: "Jackson Ave", branch: "branch14" },
      { id: 15, name: "Vernon Blvd", branch: "branch15" },
      { id: 16, name: "Queensboro Plaza", branch: "branch16" },
      { id: 17, name: "21st St", branch: "branch17" },
      { id: 18, name: "Hunters Point Ave", branch: "branch18" },
      { id: 19, name: "Jay St", branch: "branch19" },
      { id: 20, name: "High St", branch: "branch20" },
      { id: 21, name: "Nostrand Ave", branch: "branch21" },
      { id: 22, name: "Marcy Ave", branch: "branch22" },
      { id: 23, name: "Broadway", branch: "branch23" }
    ];

    const sphere = document.getElementById('sphere');
    const totalNodes = stationData.length;
    const radius = 300;
    const nodeMap = new Map();

    stationData.forEach((station, i) => {
      const node = document.createElement('div');
      node.className = 'node';
      node.dataset.stationId = station.id;

      node.innerHTML = `<div><span class="station-label">${station.name}</span><span class="station-number">Station #${station.id}</span></div>`;

      const phi = Math.acos(-1 + (2 * i) / totalNodes);
      const theta = Math.sqrt(totalNodes * Math.PI) * phi;

      const x = radius * Math.sin(phi) * Math.cos(theta);
      const y = radius * Math.sin(phi) * Math.sin(theta);
      const z = radius * Math.cos(phi);

      node.dataset.x = x;
      node.dataset.y = y;
      node.dataset.z = z;
      node.style.transform = `translate3d(${x}px, ${y}px, ${z}px)`;

      const depthOpacity = ((z + radius) / (2 * radius)) * 0.7 + 0.3;
      node.style.opacity = depthOpacity;

      node.addEventListener('click', (e) => {
        e.stopPropagation();
        selectStation(station, x, y, z);
      });

      sphere.appendChild(node);
      nodeMap.set(station.id, { node, station, x, y, z });
    });

    let currentX = 0;
    let currentY = 0;
    let targetX = 0;
    let targetY = 0;
    let autoRotationAngle = 0;

    document.querySelector('.scene').addEventListener('mousemove', (e) => {
      const rect = e.currentTarget.getBoundingClientRect();
      const xNorm = (e.clientX - rect.left) / rect.width - 0.5;
      const yNorm = (e.clientY - rect.top) / rect.height - 0.5;

      targetX = -yNorm * 60;
      targetY = xNorm * 60;
    });

    document.querySelector('.scene').addEventListener('mouseleave', () => {
      targetX = 0;
      targetY = 0;
    });

    function renderLiveModule() {
      currentX += (targetX - currentX) * 0.03;
      currentY += (targetY - currentY) * 0.03;
      autoRotationAngle += 0.7;

      sphere.style.transform = `rotateX(${currentX}deg) rotateY(${currentY + autoRotationAngle}deg)`;
      requestAnimationFrame(renderLiveModule);
    }

    function selectStation(station, x, y, z) {
      const infoPanel = document.getElementById('infoPanel');
      document.getElementById('stationName').textContent = station.name;
      document.getElementById('stationId').textContent = `${station.id}`;
      document.getElementById('stationPos').textContent = `X: ${Math.round(x)}, Y: ${Math.round(y)}, Z: ${Math.round(z)}`;

      infoPanel.classList.add('active');
    }

    renderLiveModule();
  </script>
</body>
</html>
