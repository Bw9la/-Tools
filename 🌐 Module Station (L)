<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="#baw9latech Module" content="width=device-width, initial-scale=1.0">
  <title>Live 3D Spherical Module Express Station(L)  - Transit Network</title>
  <style>
    /* ==========================================================================
       CSS STYLING & 3D VIEWPORT CONTEXT
       ========================================================================== */
    
    /* Reset and background setup to match the dark theme */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    
    body {
      background-color: #050505;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
      font-family: 'Courier New', Courier, monospace;
    }

    /* 1. Define the 3D space viewport perspective */
    .scene {
      width: 500px;
      height: 500px;
      perspective: 1200px;
      position: relative;
      cursor: grab;
    }
    
    .scene:active {
      cursor: grabbing;
    }

    /* 2. Live rotatable 3D sphere container */
    .sphere {
      width: 100%;
      height: 100%;
      position: relative;
      transform-style: preserve-3d;
      will-change: transform; /* Pushes math transformations directly to GPU */
    }

    /* 3. Structural parameters for the station node elements */
    .node {
      position: absolute;
      top: 50%;
      left: 50%;
      width: auto;
      height: auto;
      padding: 6px 10px;
      margin: -10px 0 0 -10px; /* Perfectly centers elements on coordinate points */
      font-family: 'Courier New', Courier, monospace;
      font-size: 11px;
      font-weight: bold;
      color: rgba(255, 255, 255, 0.9);
      text-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
      background-color: rgba(10, 10, 10, 0.7);
      border: 1px solid rgba(0, 255, 204, 0.3);
      border-radius: 4px;
      white-space: nowrap;
      
      /* Essential structural layer rendering properties */
      transform-style: preserve-3d;
      backface-visibility: visible; 
      user-select: none;
      display: flex;
      justify-content: center;
      align-items: center;
      transition: all 0.3s ease;
      cursor: pointer;
    }

    /* Hover effect for active nodes */
    .node:hover {
      color: #00ffcc;
      text-shadow: 0 0 12px #00ffcc;
      border-color: rgba(0, 255, 204, 0.8);
      background-color: rgba(10, 10, 10, 0.95);
      box-shadow: 0 0 20px rgba(0, 255, 204, 0.4);
      transform: scale(1.2) !important;
    }

    /* Station label styling */
    .station-label {
      display: block;
      font-size: 10px;
      opacity: 0.8;
    }

    .station-number {
      display: block;
      font-size: 9px;
      color: rgba(0, 255, 204, 0.7);
      margin-top: 2px;
      font-weight: normal;
    }

    /* Info panel for selected station */
    .info-panel {
      position: fixed;
      bottom: 20px;
      left: 20px;
      background-color: rgba(5, 5, 5, 0.95);
      border: 2px solid rgba(0, 255, 204, 0.5);
      border-radius: 8px;
      padding: 15px;
      max-width: 300px;
      color: rgba(255, 255, 255, 0.9);
      font-size: 12px;
      display: none;
      box-shadow: 0 0 30px rgba(0, 255, 204, 0.2);
      z-index: 1000;
    }

    .info-panel.active {
      display: block;
      animation: slideIn 0.3s ease;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .info-panel h3 {
      color: #00ffcc;
      margin-bottom: 8px;
      font-size: 14px;
    }

    .info-panel p {
      margin: 4px 0;
      opacity: 0.8;
    }

    /* Instructions */
    .instructions {
      position: fixed;
      top: 20px;
      right: 20px;
      background-color: rgba(5, 5, 5, 0.9);
      border: 1px solid rgba(0, 255, 204, 0.3);
      border-radius: 6px;
      padding: 12px;
      max-width: 250px;
      color: rgba(255, 255, 255, 0.7);
      font-size: 11px;
      line-height: 1.6;
    }

    .branch-list {
      position: fixed;
      left: 20px;
      top: 20px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      max-height: 70vh;
      overflow-y: auto;
      padding: 10px;
      background-color: rgba(5, 5, 5, 0.72);
      border: 1px solid rgba(0, 255, 204, 0.25);
      border-radius: 8px;
      font-size: 11px;
    }

    .branch {
      color: rgba(255, 255, 255, 0.8);
      text-decoration: none;
      padding: 4px 8px;
      border-left: 2px solid rgba(0, 255, 204, 0.4);
      transition: all 0.2s ease;
    }

    .branch:hover {
      color: #00ffcc;
      border-left-color: #00ffcc;
    }
  </style>
</head>
<body>

  <!-- ==========================================================================
       HTML STRUCTURE
       ========================================================================== -->
  <div class="scene">
    <div class="sphere" id="sphere"></div>
  </div>

  <div class="branch-list" aria-label="L line branch list">
    <a class="branch branch1" data-value="Station#1">
      Canarsie Rockaway Pkwy
    </a>

    <a class="branch branch2" data-value="Station#2">
      New Lots Av
    </a>

    <a class="branch branch3" data-value="Station#3">
      Livonia St
    </a>

    <a class="branch branch4" data-value="Station#4">
      Atlantic-Av
    </a>

    <a class="branch branch5" data-value="Station#5">
      Bushwick Av Aberdeen
    </a>

    <a class="branch branch6" data-value="Station#6">
      Halsey
    </a>

    <a class="branch branch7" data-value="Station#7">
      Dekalb
    </a>

    <a class="branch branch8" data-value="Station#8">
      Morgan
    </a>

    <a class="branch branch9" data-value="Station#9">
      Grand St
    </a>

    <a class="branch branch10" data-value="Station#10">
      Lorimer
    </a>

    <a class="branch branch11" data-value="Station#11">
      1 Av
    </a>

    <a class="branch branch12" data-value="Station#12">
      14 st Union Sq
    </a>

    <a class="branch branch13" data-value="Station#13">
      6 av
    </a>

    <a class="branch branch14" data-value="Station#14">
      8 av
    </a>
  </div>

  <!-- Info Panel for Selected Station -->
  <div class="info-panel" id="infoPanel">
    <h3 id="stationName"></h3>
    <p><strong>Module Express-Station (L) :</strong> <span id="stationId"></span></p>
    <p><strong>Position:</strong> <span id="stationPos"></span></p>
  </div>

  <!-- Instructions -->
  <div class="instructions">
    <p>🖱️ <strong>Interact:</strong> Move cursor to rotate</p>
    <p>🔗 <strong>Click:</strong> Select station</p>
    <p>⏱️ <strong>Auto:</strong> Idle rotation</p>
  </div>

  <!-- ==========================================================================
       JAVASCRIPT MATH & LIVE POINTER INTERACTION
       ========================================================================== -->
  <script>
    // Station data mapped to sphere positions
    const stationData = [
      { id: 1, name: "Canarsie Rockaway Pkwy", branch: "branch1" },
      { id: 2, name: "New Lots Av", branch: "branch2" },
      { id: 3, name: "Livonia St", branch: "branch3" },
      { id: 4, name: "Atlantic-Av", branch: "branch4" },
      { id: 5, name: "Bushwick Av Aberdeen", branch: "branch5" },
      { id: 6, name: "Halsey", branch: "branch6" },
      { id: 7, name: "Dekalb", branch: "branch7" },
      { id: 8, name: "Morgan", branch: "branch8" },
      { id: 9, name: "Grand St", branch: "branch9" },
      { id: 10, name: "Lorimer", branch: "branch10" },
      { id: 11, name: "1 Av", branch: "branch11" },
      { id: 12, name: "14 st Union Sq", branch: "branch12" },
      { id: 13, name: "6 av", branch: "branch13" },
      { id: 14, name: "8 av", branch: "branch14" },
      { id: 15, name: "Auxillary", branch: "branch15" },
      { id: 16, name: "Auxillary", branch: "branch16" },
      { id: 17, name: "Auxillary", branch: "branch17" },
      { id: 18, name: "Auxillary", branch: "branch18" },
      { id: 19, name: "Auxillary", branch: "branch19" },
      { id: 20, name: "Auxillary", branch: "branch20" },
      { id: 21, name: "Auxillary", branch: "branch21" },
      { id: 22, name: "Auxillary", branch: "branch22" }
    ];

    const sphere = document.getElementById('sphere');
    const totalNodes = stationData.length;
    const radius = 400;

    // Store node references for interaction
    const nodeMap = new Map();

    // 1. Generate and mathematically map station nodes onto a 3D Sphere Surface
    stationData.forEach((station, i) => {
      const node = document.createElement('div');
      node.className = 'node';
      node.dataset.stationId = station.id;
      
      // Create station label with ID
      node.innerHTML = `<div><span class="station-label">${station.name}</span><span class="station-number">Station #${station.id}</span></div>`;
      
      // Fibonacci Sphere algorithm for balanced distribution on a 3D sphere profile
      const phi = Math.acos(-1 + (2 * i) / totalNodes);
      const theta = Math.sqrt(totalNodes * Math.PI) * phi;

      // Convert angular Spherical parameters into Cartesian 3D system (X, Y, Z)
      const x = radius * Math.sin(phi) * Math.cos(theta);
      const y = radius * Math.sin(phi) * Math.sin(theta);
      const z = radius * Math.cos(phi);

      // Store coordinates for later reference
      node.dataset.x = x;
      node.dataset.y = y;
      node.dataset.z = z;

      // Map mathematical variables to CSS Transform parameters
      node.style.transform = `translate3d(${x}px, ${y}px, ${z}px)`;
      
      // Proportional shading based on depth placement (Z-axis)
      const depthOpacity = ((z + radius) / (2 * radius)) * 0.7 + 0.3;
      node.style.opacity = depthOpacity;

      // Add click interaction
      node.addEventListener('click', (e) => {
        e.stopPropagation();
        selectStation(station, x, y, z);
      });

      sphere.appendChild(node);
      nodeMap.set(station.id, { node, station, x, y, z });
    });

    // 2. Interactive Pointer Mechanics
    let currentX = 0;
    let currentY = 0;
    let targetX = 0;
    let targetY = 0;
    let autoRotationAngle = 0;

    // Monitor cursor positioning changes across the workspace
    document.querySelector('.scene').addEventListener('mousemove', (e) => {
      const rect = e.currentTarget.getBoundingClientRect();
      const xNorm = (e.clientX - rect.left) / rect.width - 0.5;
      const yNorm = (e.clientY - rect.top) / rect.height - 0.5;
      
      targetX = -yNorm * 60; 
      targetY = xNorm * 60;
    });

    document.querySelector('.scene').addEventListener('mouseleave', () => {
      targetX = 0;
      targetY = 0;
    });

    // 3. Smooth Frame Rate Interpolation Loop (Lerp Animation Engine)
    function renderLiveModule() {
      currentX += (targetX - currentX) * 0.03;
      currentY += (targetY - currentY) * 0.03;
      autoRotationAngle += 0.02; 
      
      sphere.style.transform = `rotateX(${currentX}deg) rotateY(${currentY + autoRotationAngle}deg)`;
      requestAnimationFrame(renderLiveModule);
    }
    
    // Station selection handler
    function selectStation(station, x, y, z) {
      const infoPanel = document.getElementById('infoPanel');
      document.getElementById('stationName').textContent = station.name;
      document.getElementById('stationId').textContent = `${station.id}`;
      document.getElementById('stationPos').textContent = `X: ${Math.round(x)}, Y: ${Math.round(y)}, Z: ${Math.round(z)}`;
      
      infoPanel.classList.add('active');
    }

    // Initialize animation loop engine
    renderLiveModule();
  </script>
</body>
</html>
