<!-- Module 2 station structure -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="#B-tech x(MTA)" content="width=device-width, initial-scale=1.0">
  <title>🌐 Express Module (2)- Transit Network</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: #050505;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
      font-family: 'Courier New', Courier, monospace;
    }
    .scene {
      width: 500px;
      height: 500px;
      perspective: 1200px;
      position: relative;
      cursor: grab;
    }
    .scene:active { cursor: grabbing; }
    .sphere {
      width: 100%;
      height: 100%;
      position: relative;
      transform-style: preserve-3d;
      will-change: transform;
    }
    .node {
      position: absolute;
      top: 50%;
      left: 50%;
      width: auto;
      height: auto;
      padding: 6px 10px;
      margin: -10px 0 0 -10px;
      font-family: 'Courier New', Courier, monospace;
      font-size: 11px;
      font-weight: bold;
      color: rgba(255, 255, 255, 0.9);
      text-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
      background-color: rgba(10, 10, 10, 0.7);
      border: 1px solid rgba(0, 255, 204, 0.3);
      border-radius: 4px;
      white-space: nowrap;
      transform-style: preserve-3d;
      backface-visibility: visible;
      user-select: none;
      display: flex;
      justify-content: center;
      align-items: center;
      transition: all 0.3s ease;
      cursor: pointer;
    }
    .node:hover {
      color: #00ffcc;
      text-shadow: 0 0 12px #00ffcc;
      border-color: rgba(0, 255, 204, 0.8);
      background-color: rgba(10, 10, 10, 0.95);
      box-shadow: 0 0 20px rgba(0, 255, 204, 0.4);
      transform: scale(1.2) !important;
    }
    .station-label { display: block; font-size: 10px; opacity: 0.8; }
    .station-number {
      display: block;
      font-size: 9px;
      color: rgba(0, 255, 204, 0.7);
      margin-top: 2px;
      font-weight: normal;
    }
    .info-panel {
      position: fixed;
      bottom: 20px;
      left: 20px;
      background-color: rgba(5, 5, 5, 0.95);
      border: 2px solid rgba(0, 255, 204, 0.5);
      border-radius: 8px;
      padding: 15px;
      max-width: 300px;
      color: rgba(255, 255, 255, 0.9);
      font-size: 12px;
      display: none;
      box-shadow: 0 0 30px rgba(0, 255, 204, 0.2);
      z-index: 1000;
    }
    .info-panel.active { display: block; animation: slideIn 0.2s ease; }
    @keyframes slideIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .info-panel h3 { color: #00ffcc; margin-bottom: 8px; font-size: 14px; }
    .info-panel p { margin: 4px 0; opacity: 0.8; }
    .instructions {
      position: fixed;
      top: 20px;
      right: 20px;
      background-color: rgba(5, 5, 5, 0.9);
      border: 1px solid rgba(0, 255, 204, 0.3);
      border-radius: 6px;
      padding: 12px;
      max-width: 250px;
      color: rgba(255, 255, 255, 0.7);
      font-size: 11px;
      line-height: 1.6;
    }
    .branch-list {
      position: fixed;
      left: 20px;
      top: 20px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      max-height: 70vh;
      overflow-y: auto;
      padding: 10px;
      background-color: rgba(5, 5, 5, 0.72);
      border: 1px solid rgba(0, 255, 204, 0.25);
      border-radius: 8px;
      font-size: 11px;
    }
    .branch {
      color: rgba(255, 255, 255, 0.8);
      text-decoration: none;
      padding: 4px 8px;
      border-left: 2px solid rgba(0, 255, 204, 0.4);
      transition: all 0.2s ease;
      cursor: pointer;
    }
    .branch:hover { color: #00ffcc; border-left-color: #00ffcc; }
  </style>
</head>
<body>
  <div class="scene">
    <div class="sphere" id="sphere"></div>
  </div>

  <div class="branch-list" aria-label="M module station branch list" id="branchList"></div>

  <div class="info-panel" id="infoPanel">
    <h3 id="stationName"></h3>
    <p><strong>Station ID:</strong> <span id="stationId"></span></p>
    <p><strong>Position:</strong> <span id="stationPos"></span></p>
  </div>

  <div class="instructions">
    <p>🖱️ <strong>Interact:</strong> Move cursor to rotate</p>
    <p>🔗 <strong>Click:</strong> Select station</p>
    <p>⏱️ <strong>Auto:</strong> Idle rotation</p>
  </div>

  <script>
    const stationNames = [
      'Wakefield 24 St',
      '233 St',
      '219 St',
      'Burke Av',
      'Pelham Parkway',
      'E 180 St',
      '174 St',
      'Simpson St',
      'Prospect Ave',
      '3 Av - 149 St',
      '135 St',
      '116 St',
      '96 St',
      '42 times Sq',
      '14 st',
      'Park pl',
      'Wall St',
      'Borough Hall',
      'Nevins St',
         'Bergen St',
'Eastern Parkway Brooklyn Mueseum',
'Medgar Evers',
'Winthrop',
'Beverly Rd',
'Flatbush Ave Brooklyn College',
    ];

    const stationData = stationNames.map((name, index) => ({
      id: index + 1,
      name,
      branch: `branch${index + 1}`
    }));

    const branchList = document.getElementById('branchList');
    stationData.forEach((station) => {
      const link = document.createElement('a');
      link.className = `branch ${station.branch}`;
      link.dataset.value = station.name;
      link.textContent = station.name;
      link.addEventListener('click', () => {
        const node = document.querySelector(`[data-station-id="${station.id}"]`);
        if (node) node.click();
      });
      branchList.appendChild(link);
    });

    const sphere = document.getElementById('sphere');
    const totalNodes = stationData.length;
    const radius = 350;

    stationData.forEach((station, i) => {
      const node = document.createElement('div');
      node.className = 'node';
      node.dataset.stationId = station.id;
      node.innerHTML = `<div><span class="station-label">${station.name}</span><span class="station-number">Station #${station.id}</span></div>`;

      const phi = Math.acos(-1 + (2 * i) / totalNodes);
      const theta = Math.sqrt(totalNodes * Math.PI) * phi;
      const x = radius * Math.sin(phi) * Math.cos(theta);
      const y = radius * Math.sin(phi) * Math.sin(theta);
      const z = radius * Math.cos(phi);

      node.dataset.x = x;
      node.dataset.y = y;
      node.dataset.z = z;
      node.style.transform = `translate3d(${x}px, ${y}px, ${z}px)`;
      node.style.opacity = ((z + radius) / (2 * radius)) * 0.7 + 0.3;
      node.addEventListener('click', (event) => {
        event.stopPropagation();
        selectStation(station, x, y, z);
      });
      sphere.appendChild(node);
    });

    let currentX = 0;
    let currentY = 0;
    let targetX = 0;
    let targetY = 0;
    let autoRotationAngle = 0;
    const scene = document.querySelector('.scene');

    scene.addEventListener('mousemove', (event) => {
      const rect = event.currentTarget.getBoundingClientRect();
      const xNorm = (event.clientX - rect.left) / rect.width - 0.5;
      const yNorm = (event.clientY - rect.top) / rect.height - 0.5;
      targetX = -yNorm * 60;
      targetY = xNorm * 60;
    });

    scene.addEventListener('mouseleave', () => {
      targetX = 0;
      targetY = 0;
    });

    function renderLiveModule() {
      currentX += (targetX - currentX) * 0.03;
      currentY += (targetY - currentY) * 0.03;
      autoRotationAngle += 0.3;
      sphere.style.transform = `rotateX(${currentX}deg) rotateY(${currentY + autoRotationAngle}deg)`;
      requestAnimationFrame(renderLiveModule);
    }

    function selectStation(station, x, y, z) {
      document.getElementById('stationName').textContent = station.name;
      document.getElementById('stationId').textContent = station.id;
      document.getElementById('stationPos').textContent = `X: ${Math.round(x)}, Y: ${Math.round(y)}, Z: ${Math.round(z)}`;
      document.getElementById('infoPanel').classList.add('active');
    }

    renderLiveModule();
  </script>
</body>
</html>
