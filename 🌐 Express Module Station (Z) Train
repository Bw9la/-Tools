<!DOCTYPE html>
<html lang="en">
 <head></head>
<meta charset="UTF-8">
<meta name="B-Tech x('MTA')" content="width=device-width, initial-scale=1.0">
<title>  🌐 Module Z-ExpressLine Transit Network</title>
<style>
  /* ==========================================================================
     CSS STYLING & 3D VIEWPORT CONTEXT
     ========================================================================== */

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background-color: #050505;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    font-family: 'Courier New', Courier, monospace;
  }

  .scene {
    width: 500px;
    height: 500px;
    perspective: 1200px;
    position: relative;
    cursor: grab;
  }

  .scene:active {
    cursor: grabbing;
  }

  .sphere {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .node {
    position: absolute;
    top: 50%;
    left: 50%;
    width: auto;
    height: auto;
    padding: 6px 10px;
    margin: -10px 0 0 -10px;
    font-family: 'Courier New', Courier, monospace;
    font-size: 11px;
    font-weight: bold;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
    background-color: rgba(10, 10, 10, 0.7);
    border: 1px solid rgba(0, 255, 204, 0.3);
    border-radius: 4px;
    white-space: nowrap;
    transform-style: preserve-3d;
    backface-visibility: visible;
    user-select: none;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .node:hover {
    color: #00ffcc;
    text-shadow: 0 0 12px #00ffcc;
    border-color: rgba(0, 255, 204, 0.8);
    background-color: rgba(10, 10, 10, 0.95);
    box-shadow: 0 0 20px rgba(0, 255, 204, 0.4);
    transform: scale(1.2) !important;
  }

  .station-label {
    display: block;
    font-size: 10px;
    opacity: 0.8;
  }

  .station-number {
    display: block;
    font-size: 9px;
    color: rgba(0, 255, 204, 0.7);
    margin-top: 2px;
    font-weight: normal;
  }

  .info-panel {
    position: fixed;
    bottom: 20px;
    left: 20px;
    background-color: rgba(5, 5, 5, 0.95);
    border: 2px solid rgba(0, 255, 204, 0.5);
    border-radius: 8px;
    padding: 15px;
    max-width: 300px;
    color: rgba(255, 255, 255, 0.9);
    font-size: 12px;
    display: none;
    box-shadow: 0 0 30px rgba(0, 255, 204, 0.2);
    z-index: 1000;
  }

  .info-panel.active {
    display: block;
    animation: slideIn 0.3s ease;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .info-panel h3 {
    color: #00ffcc;
    margin-bottom: 8px;
    font-size: 14px;
  }

  .info-panel p {
    margin: 4px 0;
    opacity: 0.8;
  }

  .instructions {
    position: fixed;
    top: 20px;
    right: 20px;
    background-color: rgba(5, 5, 5, 0.9);
    border: 1px solid rgba(0, 255, 204, 0.3);
    border-radius: 6px;
    padding: 12px;
    max-width: 250px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 11px;
    line-height: 1.6;
  }

  .branch-list {
    position: fixed;
    left: 20px;
    top: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 70vh;
    overflow-y: auto;
    padding: 10px;
    background-color: rgba(5, 5, 5, 0.72);
    border: 1px solid rgba(0, 255, 204, 0.25);
    border-radius: 8px;
    font-size: 11px;
  }

  .branch {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    padding: 4px 8px;
    border-left: 2px solid rgba(0, 255, 204, 0.4);
    transition: all 0.2s ease;
  }

  .branch:hover {
    color: #00ffcc;
    border-left-color: #00ffcc;
  }
</style>
</head>
<body>

  <div class="scene">
    <div class="sphere" id="sphere"></div>
  </div>

  <div class="branch-list" aria-label="Z Expressline branch list">
    <a class="branch branch1" data-value="station #1">
        Jamaica centre
    </a>
    <a class="branch branch2" data-value="station #2">
        121st
    </a>
    <a class="branch branch3" data-value="station #3">
        104st
    </a>
    <a class="branch branch4" data-value="station #4">
        85 st Forest pkwy
    </a>
    <a class="branch branch5" data-value="station #5">
        Cypress Hills
    </a>
    <a class="branch branch6" data-value="station #6">
        Norwood Ave
    </a>
    <a class="branch branch7" data-value="station #7">
        Van Siclen Ave
    </a>
    <a class="branch branch8" data-value="station #8">
        Broadway Junction
    </a>
    <a class="branch branch9" data-value="station #9">
        Gates Ave
    </a>
    <a class="branch branch10" data-value="station #10">
        Myrtle Ave
    </a>
    <a class="branch branch11" data-value="station #11">
        Delancey & essex st
    </a>
    <a class="branch branch12" data-value="station #12">
        Canal st
    </a>
    <a class="branch branch13" data-value="station #13">
        Fulton St
    </a>
    <a class="branch branch14" data-value="station #14">
       Auxiliray Station
        </a>
    <a class="branch branch15" data-value="station #15">   
       Auxiliray Station
        </a>
    <a class="branch branch16" data-value="station #16">
       Auxiliray Station
        </a>
    <a class="branch branch17" data-value="station #17">
       Auxiliray Station
    </a>
    <a class="branch branch18" data-value="station #18">
      Auxiliray Station
</a>
  </div>

  <div class="info-panel" id="infoPanel">
    <h3 id="stationName"></h3>
    <p><strong>Station ID:</strong> <span id="stationId"></span></p>
    <p><strong>Position:</strong> <span id="stationPos"></span></p>
  </div>

  <div class="instructions">
    <p>🖱️ <strong>Interact:</strong> Move cursor to rotate</p>
    <p>🔗 <strong>Click:</strong> Select station</p>
    <p>⏱️ <strong>Auto:</strong> Idle rotation</p>
  </div>

  <script>
    const stationData = [
      { id: 1, name: "Jamaica centre", branch: "branch1" },
      { id: 2, name: "121st", branch: "branch2" },
      { id: 3, name: "104st", branch: "branch3" },
      { id: 4, name: "85 st Forest pkwy", branch: "branch4" },
      { id: 5, name: "Cypress Hills", branch: "branch5" },
      { id: 6, name: "Norwood Ave", branch: "branch6" },
      { id: 7, name: "Van Siclen av", branch: "branch7" },
      { id: 8, name: "Broadway Junction", branch: "branch8" },
      { id: 9, name: "Gates Av", branch: "branch9" },
      { id: 10, name: "Myrtle av", branch: "branch10" },
      { id: 11, name: "Delancey & essex st", branch: "branch11" },
      { id: 12, name: "Canal st", branch: "branch12" },
      { id: 13, name: "Fulton", branch: "branch13" },
      { id: 14, name: "Auxiliray Station", branch: "branch14" },
      { id: 15, name: "Auxiliray Station", branch: "branch15" },
      { id: 16, name: "Auxiliray Station ", branch: "branch16" },
      { id: 17, name: "Auxiliray Station", branch: "branch17" },
      { id: 18, name: "Auxiliray Station", branch: "branch18" },
      { id: 19, name: "Auxiliary Station", branch: "branch19" },
      { id: 20, name: "Auxiliary Station", branch: "branch20" },
      { id: 21, name: "Auxiliary Station", branch: "branch21" },
      { id: 22, name: "Auxiliary Station", branch: "branch22" },
      { id: 23, name: "Auxiliary Station", branch: "branch23" },
      { id: 24, name: "Auxiliary Station", branch: "branch24" },
      { id: 25, name: "Auxiliary Station", branch: "branch25" },
      { id: 26, name: "Auxiliary Station", branch: "branch26" },
      { id: 27, name: "Auxiliary Station", branch: "branch27" },
      { id: 28, name: "Auxiliary Station", branch: "branch28" },
      { id: 29, name: "Auxiliary Station", branch: "branch29" },
      { id: 30, name: "Auxiliary Station", branch: "branch30" },
      { id: 31, name: "Auxiliary Station", branch: "branch31" },
      { id: 32, name: "Auxiliary Station", branch: "branch32" },
      { id: 33, name: "Auxiliary Station", branch: "branch33" },
      { id: 34, name: "Auxiliary Station", branch: "branch34" },
      { id: 35, name: "Auxiliary Station", branch: "branch35" },
      { id: 36, name: "Auxiliary Station", branch: "branch36" }
    ];

    const sphere = document.getElementById('sphere');
    const totalNodes = stationData.length;
    const radius = 380;
    const nodeMap = new Map();

    stationData.forEach((station, i) => {
      const node = document.createElement('div');
      node.className = 'node';
      node.dataset.stationId = station.id;

      node.innerHTML = `<div><span class="station-label">${station.name}</span><span class="station-number">Station #${station.id}</span></div>`;

      const phi = Math.acos(-1 + (2 * i) / totalNodes);
      const theta = Math.sqrt(totalNodes * Math.PI) * phi;

      const x = radius * Math.sin(phi) * Math.cos(theta);
      const y = radius * Math.sin(phi) * Math.sin(theta);
      const z = radius * Math.cos(phi);

      node.dataset.x = x;
      node.dataset.y = y;
      node.dataset.z = z;
      node.style.transform = `translate3d(${x}px, ${y}px, ${z}px)`;

      const depthOpacity = ((z + radius) / (2 * radius)) * 0.7 + 0.3;
      node.style.opacity = depthOpacity;

      node.addEventListener('click', (e) => {
        e.stopPropagation();
        selectStation(station, x, y, z);
      });

      sphere.appendChild(node);
      nodeMap.set(station.id, { node, station, x, y, z });
    });

    let currentX = 0;
    let currentY = 0;
    let targetX = 0;
    let targetY = 0;
    let autoRotationAngle = 0;

    document.querySelector('.scene').addEventListener('mousemove', (e) => {
      const rect = e.currentTarget.getBoundingClientRect();
      const xNorm = (e.clientX - rect.left) / rect.width - 0.5;
      const yNorm = (e.clientY - rect.top) / rect.height - 0.5;

      targetX = -yNorm * 60;
      targetY = xNorm * 60;
    });

    document.querySelector('.scene').addEventListener('mouseleave', () => {
      targetX = 0;
      targetY = 0;
    });

    function renderLiveModule() {
      currentX += (targetX - currentX) * 0.03;
      currentY += (targetY - currentY) * 0.03;
      autoRotationAngle += 0.3;

      sphere.style.transform = `rotateX(${currentX}deg) rotateY(${currentY + autoRotationAngle}deg)`;
      requestAnimationFrame(renderLiveModule);
    }

    function selectStation(station, x, y, z) {
      const infoPanel = document.getElementById('infoPanel');
      document.getElementById('stationName').textContent = station.name;
      document.getElementById('stationId').textContent = `${station.id}`;
      document.getElementById('stationPos').textContent = `X: ${Math.round(x)}, Y: ${Math.round(y)}, Z: ${Math.round(z)}`;

      infoPanel.classList.add('active');
    }

    renderLiveModule();
  </script>
</body>
</html>
